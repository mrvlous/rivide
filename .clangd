# Configuration file for clangd Language Server Protocol (LSP) language engine.
# Provides real-time syntax checking, auto-completion, static analysis integration,
# and background indexing for C99 development across the Rivide project.

# Compiler options and include paths
CompileFlags:
  # Location of CMake-generated JSON compilation database
  CompilationDatabase: build

  # Flag additions to enforce strict ISO C99 standards during LSP analysis
  Add:
    - -std=c99
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Werror
    - -Iinclude
    - -D_POSIX_C_SOURCE=200809L

# Static analysis and diagnostic warning thresholds
Diagnostics:
  # Static analysis check passes executed in real-time by clang-tidy
  ClangTidy:
    Add:
      - bugprone-*
      - cert-*
      - performance-*
      - readability-*
    Remove:
      - readability-identifier-length
      - readability-magic-numbers

  # Include header audit enforcement settings
  UnusedIncludes: Strict
  MissingIncludes: Strict

# Indexing engine background behavior
Index:
  # Enable background indexing of source and header files in the build tree
  Background: Build

# Editor inlay hint annotations for parameter names and types
InlayHints:
  Designators: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

# Code completion and hover tooltip behavior
Hover:
  ShowAKA: Yes
